{
  "name": "carbon-tracker",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "start": "npm run start --workspace @carbon-tracker/mobile --",
    "android": "npm run android --workspace @carbon-tracker/mobile --",
    "ios": "npm run ios --workspace @carbon-tracker/mobile --",
    "web": "npm run web --workspace @carbon-tracker/mobile --",
    "lint": "npm run lint --workspace @carbon-tracker/mobile --",
    "typecheck": "npm run typecheck --workspace @carbon-tracker/mobile --",
    "test": "npm run test --workspace @carbon-tracker/mobile --",
    "test:watch": "npm run test:watch --workspace @carbon-tracker/mobile --",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "firmware:build": "pio -d apps/firmware/esp32-carbon-tracker run",
    "firmware:upload": "pio -d apps/firmware/esp32-carbon-tracker run --target upload",
    "firmware:monitor": "pio -d apps/firmware/esp32-carbon-tracker device monitor"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.5.14"
  }
}
